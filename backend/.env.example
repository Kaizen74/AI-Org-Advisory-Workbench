# Copy this file to `.env` and fill in your values. `.env` is gitignored — it never reaches GitHub.

# Your Anthropic API key (create one at https://console.anthropic.com). Optional for non-AI screens.
ANTHROPIC_API_KEY=

# Model strings (sensible defaults are used if unset).
MODEL_EXTRACT=claude-sonnet-5
MODEL_SYNTH=claude-opus-4-8

# Database (SQLite for local dev; a Postgres URL in production).
DATABASE_URL=sqlite+aiosqlite:///./advisory_workbench.db
# Production example (Railway/Render give you this — use the asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Salt for anonymization pseudonyms — set a long random value in production.
ANON_SALT=change-me-to-a-long-random-string

# ── Private access control (the app is NOT public) ──
# Secret that signs login tokens — set a long random value in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Bootstrap the sign-in allowlist on first run: "email:passcode" pairs, comma-separated.
# These first users are owners and can add/remove others in the app's Settings → Access control.
ACCESS_USERS=you@example.com:choose-a-strong-passcode
# How long a sign-in lasts before re-login (hours).
AUTH_TOKEN_TTL_HOURS=12

# Optional: restrict which frontend origins may call the API (comma-separated).
# CORS_ORIGINS=https://your-frontend.vercel.app
